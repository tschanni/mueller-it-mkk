REACT_APP_GAME_API_BASE_URL=https://api.mueller-it-mkk.de

# Enable only after the new whitelist backend endpoints are deployed and verified.
REACT_APP_MINECRAFT_LIVE_WHITELIST=false

# Auth-Basis laut docs/AUTH_API_CONTRACT.md; keine Secrets im Frontend.
# Produktion verwendet diesen Standard:
# REACT_APP_AUTH_API_BASE_URL=https://api.mueller-it-mkk.de/games/api/v1/auth
# npm start auf localhost verwendet standardmaessig ein lokales Backend auf 3001:
# REACT_APP_AUTH_API_BASE_URL=http://localhost:3001/api/v1/auth

# Erst nach Backend-Abstimmung konfigurieren, siehe docs/LOGIN_PROFILE_SEO.md.
# Multipart-Upload auf derselben API-Origin; Antwort: { "image": "https://.../versioned.png" }
# REACT_APP_PROFILE_IMAGE_UPLOAD_URL=
# Session-geschÃ¼tzter Kartenproxy auf derselben API-Origin, unabhÃ¤ngig von Minecraft-Link/Whitelist.
# REACT_APP_MINECRAFT_MAP_URL=
